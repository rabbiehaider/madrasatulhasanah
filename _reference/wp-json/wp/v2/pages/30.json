{"id":30,"date":"2021-11-30T13:23:28","date_gmt":"2021-11-30T13:23:28","guid":{"rendered":"https:\/\/www.madrasatulhasanah.com\/?page_id=30"},"modified":"2024-10-13T09:46:51","modified_gmt":"2024-10-13T09:46:51","slug":"%e0%a6%b9%e0%a7%8b%e0%a6%ae","status":"publish","type":"page","link":"https:\/\/www.madrasatulhasanah.com\/","title":{"rendered":"\u09b9\u09cb\u09ae"},"content":{"rendered":"\t\t<div data-elementor-type=\"wp-page\" data-elementor-id=\"30\" class=\"elementor elementor-30\" data-elementor-settings=\"[]\">\n\t\t\t\t\t\t\t<div class=\"elementor-section-wrap\">\n\t\t\t\t\t\t\t<section class=\"elementor-section elementor-top-section elementor-element elementor-element-cc37756 elementor-section-boxed elementor-section-height-default elementor-section-height-default\" data-id=\"cc37756\" data-element_type=\"section\">\n\t\t\t\t\t\t<div class=\"elementor-container elementor-column-gap-default\">\n\t\t\t\t\t<div class=\"elementor-column elementor-col-100 elementor-top-column elementor-element elementor-element-381138e\" data-id=\"381138e\" data-element_type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t\t\t<div class=\"elementor-element elementor-element-a047363 elementor-widget elementor-widget-heading\" data-id=\"a047363\" data-element_type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t<h2 class=\"elementor-heading-title elementor-size-medium\">\u0986\u09ae\u09be\u09a6\u09c7\u09b0 \u0995\u09a5\u09be<\/h2>\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t\t\t<\/div>\n\t\t<\/section>\n\t\t\t\t<section class=\"elementor-section elementor-top-section elementor-element elementor-element-a184d2b elementor-section-boxed elementor-section-height-default elementor-section-height-default\" data-id=\"a184d2b\" data-element_type=\"section\">\n\t\t\t\t\t\t<div class=\"elementor-container elementor-column-gap-default\">\n\t\t\t\t\t<div class=\"elementor-column elementor-col-100 elementor-top-column elementor-element elementor-element-7b7742f\" data-id=\"7b7742f\" data-element_type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t\t\t<div class=\"elementor-element elementor-element-67b5497 elementor-widget elementor-widget-text-editor\" data-id=\"67b5497\" data-element_type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t<p>\u09ac\u09bf\u09b8\u09ae\u09bf\u09b2\u09cd\u09b2\u09be\u09b9\u09bf\u09b0 \u09b0\u09b9\u09ae\u09be\u09a8\u09bf\u09b0 \u09b0\u09b9\u09c0\u09ae<\/p>\n<p>\u09a6\u09c1\u09a8\u09bf\u09df\u09be \u0993 \u0986\u0996\u09bf\u09b0\u09be\u09a4\u09c7\u09b0 \u0995\u09b2\u09cd\u09af\u09be\u09a3\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u0986\u09a8\u09cd\u09a4\u09b0\u09cd\u099c\u09be\u09a4\u09bf\u0995 \u09ae\u09be\u09a8\u09c7\u09b0 \u09b6\u09bf\u0995\u09cd\u09b7\u09be\u09b0 \u0985\u0999\u09cd\u0997\u09c0\u0995\u09be\u09b0 \u09a8\u09bf\u09df\u09c7 \u09b8\u09be\u09ad\u09be\u09b0\u09c7 \u09b6\u09c1\u09b0\u09c1 \u09b9\u09b2\u09cb<br \/>\u0645\u062f\u0631\u0633\u0629 \u0627\u0644\u062d\u0633\u0646\u0629\u00a0\u09ae\u09be\u09a6\u09b0\u09be\u09b8\u09be\u09a4\u09c1\u09b2 \u09b9\u09be\u09b8\u09be\u09a8\u09be\u09b9<\/p>\n<p><em>\u09b9\u09c7 \u0986\u09ae\u09be\u09a6\u09c7\u09b0 \u09aa\u09be\u09b2\u09a8\u0995\u09b0\u09cd\u09a4\u09be!\u0986\u09ae\u09be\u09a6\u09c7\u09b0\u0995\u09c7 \u09a6\u09c1\u09a8\u09bf\u09df\u09be\u09a4\u09c7\u0993 \u0995\u09b2\u09cd\u09af\u09be\u09a3 \u09a6\u09be\u09a8 \u0995\u09b0\u09cb; \u0986\u0996\u09bf\u09b0\u09be\u09a4\u09c7\u0993 \u0995\u09b2\u09cd\u09af\u09be\u09a3 \u09a6\u09be\u09a8 \u0995\u09b0\u09cb\u0964 \u0986\u09b0 \u099c\u09be\u09b9\u09be\u09a8\u09cd\u09a8\u09be\u09ae\u09c7\u09b0 \u0986\u099c\u09be\u09ac \u09b9\u09a4\u09c7\u0993 \u09b0\u0995\u09cd\u09b7\u09be \u0995\u09b0\u09cb \u0964<\/em> -\u09b8\u09c2\u09b0\u09be \u0986\u09b2 \u09ac\u09be\u0995\u09be\u09b0\u09be \u09e8\u09e6\u09e7<\/p>\n<p>\u09b8\u09ae\u09cd\u09ae\u09be\u09a8\u09bf\u09a4 \u09b8\u09c1\u09a7\u09c0,<\/p>\n<p>\u0986\u09b8\u09b8\u09be\u09b2\u09be\u09ae\u09c1 \u0986\u09b2\u09be\u0987\u0995\u09c1\u09ae\u0964 \u09a6\u09c1\u09a8\u09bf\u09df\u09be \u098f\u09ac\u0982 \u0986\u0996\u09bf\u09b0\u09be\u09a4\u09c7\u09b0 \u0995\u09b2\u09cd\u09af\u09be\u09a3 \u09b2\u09be\u09ad\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u09a6\u09c1\u09df\u09be \u0995\u09b0\u09be\u09b0 \u09aa\u09be\u09b6\u09be\u09aa\u09be\u09b6\u09bf &#8216;\u0987\u09b2\u09ae \u098f\u09ac\u0982 &#8216;\u0986\u09ae\u09b2\u09c7\u09b0 \u09ae\u09be\u09a7\u09cd\u09af\u09ae\u09c7 \u0986\u09ae\u09be\u09a6\u09c7\u09b0 \u09b8\u09b0\u09cd\u09ac\u09be\u09a4\u09cd\u09ae\u0995 \u09aa\u09cd\u09b0\u099a\u09c7\u09b7\u09cd\u099f\u09be \u0993 \u0985\u09ac\u09cd\u09af\u09be\u09b9\u09a4 \u09b0\u09be\u0996\u09a4\u09c7 \u09b9\u09ac\u09c7\u0964 \u0986\u09ae\u09be\u09a6\u09c7\u09b0 \u09aa\u09cd\u09b0\u09a4\u09bf\u09b7\u09cd\u09a0\u09be\u09a8 \u09ae\u09be\u09a6\u09b0\u09be\u09b8\u09be\u09a4\u09c1\u09b2 \u09b9\u09be\u09b8\u09be\u09a8\u09be\u09b9 \u09b8\u09c7 \u09b2\u0995\u09cd\u09b7\u09cd\u09af\u09c7\u0987 \u09aa\u09cd\u09b0\u09a4\u09bf\u09b7\u09cd\u09a0\u09bf\u09a4 \u09b9\u09df\u09c7\u099b\u09c7\u0964<\/p>\n<p>\u0986\u09aa\u09a8\u09be\u09b0\u09be \u099c\u09be\u09a8\u09c7\u09a8, \u0986\u09ae\u09be\u09a6\u09c7\u09b0 \u09a6\u09c7\u09b6\u09c7 \u09b0\u09df\u09c7\u099b\u09c7 \u09a8\u09be\u09a8\u09be \u09b0\u0995\u09ae \u09b6\u09bf\u0995\u09cd\u09b7\u09be\u09ac\u09cd\u09af\u09ac\u09b8\u09cd\u09a5\u09be-\u099c\u09c7\u09a8\u09be\u09b0\u09c7\u09b2 \u09b6\u09bf\u0995\u09cd\u09b7\u09be, \u0986\u09b2\u09c0\u09df\u09be, \u0995\u0989\u09ae\u09c0, \u09b9\u09bf\u09ab\u099c\u09c1\u09b2 \u0995\u09c1\u09b0\u0986\u09a8, \u0987\u0982\u09b2\u09bf\u09b6 \u09ae\u09bf\u09a1\u09bf\u09df\u09be\u09ae, \u0995\u09be\u09b0\u09bf\u0997\u09b0\u09c0 \u00a0\u0987\u09a4\u09cd\u09af\u09be\u09a6\u09bf\u0964 \u098f \u09b8\u09ac\u09c7\u09b0 \u09b8\u09ae\u09a8\u09cd\u09ac\u09df\u09c7 \u098f\u0995\u099f\u09bf \u0986\u09a8\u09cd\u09a4\u09b0\u09cd\u099c\u09be\u09a4\u09bf\u0995 \u09ae\u09be\u09a8\u09c7\u09b0\u00a0 \u09b6\u09bf\u0995\u09cd\u09b7\u09be\u09aa\u09cd\u09b0\u09a4\u09bf\u09b7\u09cd\u09a0\u09be\u09a8 \u0997\u09dc\u09a4\u09c7 \u0986\u09ae\u09b0\u09be \u0995\u09be\u099c \u0995\u09b0\u09c7 \u09af\u09be\u099a\u09cd\u099b\u09bf\u0964 \u098f\u0996\u09be\u09a8\u09c7 \u0995\u09c1\u09b0\u0986\u09a8-\u09b8\u09c1\u09a8\u09cd\u09a8\u09be\u09b9\u09ad\u09bf\u09a4\u09cd\u09a4\u09bf\u0995 \u09b6\u09c1\u09a6\u09cd\u09a7 \u0987\u09b8\u09b2\u09be\u09ae \u0985\u09a8\u09c1\u09a7\u09be\u09ac\u09a8 \u0993\u00a0 \u0985\u09a8\u09c1\u09b6\u09c0\u09b2\u09a8, \u098f\u09ac\u0982 \u0986\u09ae\u09be\u09a6\u09c7\u09b0 \u099c\u09be\u09a4\u09c0\u09df \u0989\u09a8\u09cd\u09a8\u09a4\u09bf\u09b0 \u09b2\u0995\u09cd\u09b7\u09cd\u09af\u09c7 \u0986\u099c\u0995\u09c7\u09b0 \u09b6\u09bf\u09b6\u09c1\u09a6\u09c7\u09b0\u0995\u09c7 \u0986\u0997\u09be\u09ae\u09c0 \u09a6\u09bf\u09a8\u09c7\u09b0 \u09b8\u09c1\u09a8\u09be\u0997\u09b0\u09bf\u0995 \u09b9\u09bf\u09b8\u09c7\u09ac\u09c7 \u0997\u09dc\u09c7 \u09a4\u09cb\u09b2\u09be\u09b0 \u09ac\u09bf\u09b7\u09df\u099f\u09bf \u09b8\u09b0\u09cd\u09ac\u09be\u09a7\u09bf\u0995 \u0997\u09c1\u09b0\u09c1\u09a4\u09cd\u09ac \u09a6\u09bf\u09df\u09c7 \u0986\u09a6\u09ac, \u0986\u0996\u09b2\u09be\u0995, \u0986\u09b0 \u09a4\u09be\u0995\u0993\u09df\u09be\u09b0 \u09b8\u09ac\u0995 \u098f\u09ac\u0982 \u09b8\u09ae\u0995\u09be\u09b2\u09c0\u09a8 \u099c\u09cd\u099e\u09be\u09a8-\u09ac\u09bf\u099c\u09cd\u099e\u09be\u09a8-\u09aa\u09cd\u09b0\u09af\u09c1\u0995\u09cd\u09a4\u09bf\u09b0 \u09aa\u09cd\u09b0\u09b6\u09bf\u0995\u09cd\u09b7\u09a3\u09c7\u09b0 \u09ae\u09be\u09be\u09a7\u09cd\u09af\u09ae\u09c7 \u0986\u09aa\u09a8\u09be\u09b0-\u0986\u09ae\u09be\u09b0 \u0995\u09b2\u09bf\u099c\u09be\u09b0 \u099f\u09c1\u0995\u09b0\u09cb\u0997\u09c1\u09b2\u09cb\u0995\u09c7 \u09a4\u09be\u0993\u09b9\u09c0\u09a6\u09c0 \u09b8\u09cb\u09a8\u09be\u09b0 \u09ae\u09be\u09a8\u09c1\u09b7 \u09ac\u09be\u09a8\u09be\u09a4\u09c7 \u099a\u09be\u0987\u0964<\/p>\n<p>\u0986\u09b2\u09cd\u09b2\u09be\u09b9 \u09b0\u09ac\u09cd\u09ac\u09c1\u09b2 \u0986\u09b2\u09be\u09ae\u09c0\u09a8 \u0986\u09aa\u09a8\u09be\u09a6\u09c7\u09b0 \u09b8\u09b9\u09be\u09df \u09b9\u09cb\u09a8\u0964<\/p>\n<p>\u099c\u09be\u09af\u09be\u0995\u09c1\u09ae\u09c1\u09b2\u09cd\u09b2\u09be\u09b9 \u0996\u09be\u0987\u09b0\u09be\u09a8\u0964<br \/><br \/><\/p>\n<h4><strong>\u0986\u09ae\u09be\u09a6\u09c7\u09b0 \u09ac\u09c8\u09b6\u09bf\u09b7\u09cd\u099f\u09cd\u09af<\/strong><\/h4>\n<p><strong>\u00a0<\/strong><\/p>\n<p><strong>\u0995\u09be\u09b0\u09bf\u0995\u09bf\u09df\u09c1\u09b2\u09be\u09ae \u098f\u09ac\u0982 \u09b8\u09bf\u09b2\u09c7\u09ac\u09be\u09b8<\/strong><\/p>\n<p>\u09ac\u09be\u0982\u09b2\u09be\u09a6\u09c7\u09b6 \u09ae\u09be\u09a6\u09b0\u09be\u09b8\u09be \u09b6\u09bf\u0995\u09cd\u09b7\u09be\u09ac\u09cb\u09b0\u09cd\u09a1\u09c7\u09b0 \u09aa\u09be\u09a0\u09cd\u09af\u09aa\u09c1\u09b8\u09cd\u09a4\u0995\u09c7\u09b0 \u09aa\u09be\u09b6\u09be\u09aa\u09be\u09b6\u09bf \u0986\u0995\u09c0\u09a6\u09be\u09b9-\u09ab\u09bf\u0995\u09b9\u09c7\u09b0 \u0986\u09b0\u09ac\u09c0 \u0995\u09bf\u09a4\u09be\u09ac, \u09b8\u09cc\u09a6\u09bf \u09ac\u09bf\u09b6\u09cd\u09ac\u09ac\u09bf\u09a6\u09cd\u09af\u09be\u09b2\u09df\u09c7\u09b0 Arabic Language \u098f\u09ac\u0982 Oxford, Cambridge, Longman, Mc Graw Hill \u09aa\u09cd\u09b0\u0995\u09be\u09b6\u09bf\u09a4 \u0987\u0982\u09b0\u09c7\u099c\u09bf \u09ac\u0987 \u09aa\u09dc\u09be\u09a8\u09cb \u09b9\u09df\u0964<\/p>\n<p>\u00a0<\/p>\n<p><strong>\u09a4\u09be\u09b9\u09ab\u09c0\u099c\u09c1\u09b2 \u0995\u09c1\u09b0\u0986\u09a8<\/strong><\/p>\n<p>\u0985\u09ad\u09bf\u099c\u09cd\u099e \u09b9\u09be\u09ab\u09c7\u099c-\u09b9\u09be\u09ab\u09c7\u099c\u09be \u09a6\u09cd\u09ac\u09be\u09b0\u09be \u099b\u09be\u09a4\u09cd\u09b0 \u0993 \u099b\u09be\u09a4\u09cd\u09b0\u09c0\u09a6\u09c7\u09b0 \u09aa\u09c3\u09a5\u0995\u09ad\u09be\u09ac\u09c7 \u09a4\u09be\u09b9\u09ab\u09c0\u099c\u09c1\u09b2 \u0995\u09c1\u09b0\u0986\u09a8\u09c7\u09b0 (\u09ae\u0995\u09cd\u09a4\u09ac, \u09a8\u09be\u099c\u09c7\u09b0\u09be, \u09b9\u09bf\u09ab\u099c, \u09b0\u09bf\u09ad\u09bf\u09b6\u09a8) \u0995\u09cd\u09b2\u09be\u09b8 \u09a8\u09c7\u09df\u09be \u09b9\u09df\u0964 \u09b8\u09ac \u0995\u09cd\u09b2\u09be\u09b8\u09c7\u0987 \u0995\u09c1\u09b0\u0986\u09a8, \u09b9\u09be\u09a6\u09c0\u09b8 \u098f\u09ac\u0982 \u09ae\u09be\u09b8\u09a8\u09c1\u09a8 \u09a6\u09c1\u0986 \u09ae\u09c1\u0996\u09b8\u09cd\u09a5 \u0995\u09b0\u09be\u09a8\u09cb \u09b9\u09df\u0964<\/p>\n<p>\u00a0<\/p>\n<p><strong>\u099c\u09c0\u09ac\u09a8\u09ae\u09c1\u0996\u09c0 \u09b6\u09bf\u0995\u09cd\u09b7\u09be<\/strong><\/p>\n<p>\u09b6\u09bf\u0995\u09cd\u09b7\u09be\u09b0\u09cd\u09a5\u09c0\u09a6\u09c7\u09b0\u0995\u09c7 \u09b8\u09be\u09b2\u09be\u09a4, \u09a6\u09c8\u09a8\u09a8\u09cd\u09a6\u09bf\u09a8 &#8216;\u0986\u09ae\u09b2, \u09af\u09bf\u0995\u09b0-\u0986\u09af\u0995\u09be\u09b0, \u0986\u09a6\u09ac-\u0986\u0996\u09b2\u09be\u0995 \u09aa\u09cd\u09b0\u09b6\u09bf\u0995\u09cd\u09b7\u09a3\u09c7\u09b0 \u09aa\u09be\u09b6\u09be\u09aa\u09be\u09b6\u09bf Co-curricular activities \u0986\u09df\u09cb\u099c\u09a8 \u0995\u09b0\u09be \u09b9\u09df\u0964<\/p>\n<p>\u00a0<\/p>\n<p><strong>\u09b6\u09bf\u0995\u09cd\u09b7\u09be \u09ac\u09cd\u09af\u09ac\u09b8\u09cd\u09a5\u09be\u09aa\u09a8\u09be<\/strong><\/p>\n<p>\u0989\u099a\u09cd\u099a \u09b6\u09bf\u0995\u09cd\u09b7\u09bf\u09a4, \u09aa\u09cd\u09b0\u09b6\u09bf\u0995\u09cd\u09b7\u09bf\u09a4 \u098f\u09ac\u0982 \u0985\u09ad\u09bf\u099c\u09cd\u099e \u09b6\u09bf\u0995\u09cd\u09b7\u0995\u09ae\u09a8\u09cd\u09a1\u09b2\u09c0 \u09a6\u09cd\u09ac\u09be\u09b0\u09be \u09b6\u09bf\u09b6\u09c1\u09a6\u09c7\u09b0\u0995\u09c7 \u09ae\u09be\u09a4\u09c3\u09b8\u09cd\u09a8\u09c7\u09b9\u09c7 \u09b6\u09bf\u0995\u09cd\u09b7\u09be\u09a6\u09be\u09a8, \u09aa\u09cd\u09b0\u09ac\u09be\u09b8\u09c0\u09a6\u09c7\u09b0 \u09b8\u09a8\u09cd\u09a4\u09be\u09a8\u09a6\u09c7\u09b0 \u09b8\u09c1\u09b6\u09bf\u0995\u09cd\u09b7\u09be\u09b0 \u09a6\u09be\u09df\u09bf\u09a4\u09cd\u09ac \u0997\u09cd\u09b0\u09b9\u09a3, \u0985\u09ad\u09bf\u09ad\u09be\u09ac\u0995\u09a6\u09c7\u09b0 \u09b8\u09be\u09a5\u09c7 \u09a8\u09bf\u09df\u09ae\u09bf\u09a4 \u09ae\u09a4\u09ac\u09bf\u09a8\u09bf\u09ae\u09df \u098f\u09ac\u0982 \u0997\u09a3\u09ae\u09c1\u0996\u09c0 \u0987\u09b8\u09b2\u09be\u09ae\u09c0 \u09aa\u09cd\u09b0\u09cb\u0997\u09cd\u09b0\u09be\u09ae \u0986\u09df\u09cb\u099c\u09a8 \u0995\u09b0\u09be \u09b9\u09df\u0964<\/p>\n<p>\u00a0<\/p>\n<p><strong>\u09aa\u09b0\u09c0\u0995\u09cd\u09b7\u09be \u0993 \u09b8\u09be\u09b0\u09cd\u099f\u09bf\u09ab\u09bf\u0995\u09c7\u099f<\/strong><\/p>\n<p>\u09aa\u09b0\u09c0\u0995\u09cd\u09b7\u09be \u0993 \u09ae\u09c2\u09b2\u09cd\u09af\u09be\u09df\u09a8\u09c7\u09b0 \u0995\u09cd\u09b7\u09c7\u09a4\u09cd\u09b0\u09c7 \u09ac\u09be\u0982\u09b2\u09be\u09a6\u09c7\u09b6 \u09ae\u09be\u09a6\u09b0\u09be\u09b8\u09be \u09b6\u09bf\u0995\u09cd\u09b7\u09be\u09ac\u09cb\u09b0\u09cd\u09a1 \u098f\u09ac\u0982 IELTS \u098f\u09b0 Skill-Based \u09aa\u09a6\u09cd\u09a7\u09a4\u09bf \u0985\u09a8\u09c1\u09b8\u09b0\u09a3 \u0995\u09b0\u09be \u09b9\u09df\u0964<\/p>\n<p>\u00a0<\/p>\n<p><strong>\u0986\u09a7\u09c1\u09a8\u09bf\u0995 \u0986\u09ac\u09be\u09b8\u09bf\u0995 \u09ac\u09bf\u09ad\u09be\u0997<\/strong><\/p>\n<p>\u0986\u09a7\u09c1\u09a8\u09bf\u0995 \u09ad\u09ac\u09a8\u09c7 \u09b8\u09be\u09b0\u09cd\u09ac\u0995\u09cd\u09b7\u09a3\u09bf\u0995 \u09a8\u09bf\u09b0\u09be\u09aa\u09a4\u09cd\u09a4\u09be \u098f\u09ac\u0982 \u09b8\u09cd\u09ac\u09be\u09b8\u09cd\u09a5\u09cd\u09af\u09b8\u09ae\u09cd\u09ae\u09a4 \u09aa\u09b0\u09bf\u09ac\u09c7\u09b6\u09c7 \u0989\u09a8\u09cd\u09a8\u09a4 \u09ae\u09be\u09a8\u09c7\u09b0 \u0996\u09be\u09ac\u09be\u09b0 \u098f\u09ac\u0982 \u09aa\u09cd\u09b0\u09df\u09cb\u099c\u09a8\u09c0\u09df \u09b8\u09c1\u09ac\u09bf\u09a7\u09be\u09b8\u09b9 \u099b\u09be\u09a4\u09cd\u09b0-\u099b\u09be\u09a4\u09cd\u09b0\u09c0 \u0989\u09ad\u09df\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u09aa\u09c3\u09a5\u0995 \u0986\u09ac\u09be\u09b8\u09bf\u0995 \u09ac\u09cd\u09af\u09ac\u09b8\u09cd\u09a5\u09be \u09b0\u09df\u09c7\u099b\u09c7\u0964<\/p>\n<p>\u00a0<\/p>\n<p><strong>\u09b6\u09bf\u0995\u09cd\u09b7\u09be\u09b0 \u09ae\u09be\u09a8<\/strong><\/p>\n<p>\u09ad\u09be\u09b7\u09be \u09b6\u09bf\u0995\u09cd\u09b7\u09be\u09a6\u09be\u09a8\u09c7\u09b0 \u0995\u09cd\u09b7\u09c7\u09a4\u09cd\u09b0\u09c7 CEFR (Common European Framework of Reference for Languages) \u0985\u09a8\u09c1\u09b8\u09b0\u09a3 \u0995\u09b0\u09be \u09b9\u09df\u0964 Projector \u09b8\u09ae\u09c3\u09a6\u09cd\u09a7 \u0995\u09cd\u09b2\u09be\u09b8\u09c7 Textbook \u098f\u09ac\u0982 Audio-Visual Materials \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0 \u0995\u09b0\u09be \u09b9\u09df\u0964<\/p>\n<p><!-- \/wp:paragraph --><!-- wp:paragraph --><\/p>\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t\t\t<\/div>\n\t\t<\/section>\n\t\t\t\t<section class=\"elementor-section elementor-top-section elementor-element elementor-element-4b4bc01 elementor-section-boxed elementor-section-height-default elementor-section-height-default\" data-id=\"4b4bc01\" data-element_type=\"section\">\n\t\t\t\t\t\t<div class=\"elementor-container elementor-column-gap-default\">\n\t\t\t\t\t<div class=\"elementor-column elementor-col-100 elementor-top-column elementor-element elementor-element-6895709\" data-id=\"6895709\" data-element_type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t\t\t<div class=\"elementor-element elementor-element-d9eaf3b elementor-widget elementor-widget-heading\" data-id=\"d9eaf3b\" data-element_type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t<h2 class=\"elementor-heading-title elementor-size-medium\">\u09a8\u09cb\u099f\u09bf\u09b6 \u09ac\u09cb\u09b0\u09cd\u09a1<\/h2>\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t\t\t<\/div>\n\t\t<\/section>\n\t\t\t\t<section class=\"elementor-section elementor-top-section elementor-element elementor-element-e4780ca ele