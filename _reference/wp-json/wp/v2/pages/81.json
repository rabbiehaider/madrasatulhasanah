ntor-section-height-default\" data-id=\"292560ba\" data-element_type=\"section\">\n\t\t\t\t\t\t<div class=\"elementor-container elementor-column-gap-default\">\n\t\t\t\t\t<div class=\"elementor-column elementor-col-100 elementor-top-column elementor-element elementor-element-64c10d67\" data-id=\"64c10d67\" data-element_type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t\t\t<div class=\"elementor-element elementor-element-4262c5c3 elementor-widget elementor-widget-text-editor\" data-id=\"4262c5c3\" data-element_type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t<p><!-- wp:paragraph --><\/p>\n<p><strong>\u09ac\u09bf\u09b8\u09ae\u09bf\u09b2\u09cd\u09b2\u09be\u09b9\u09bf\u09b0 \u09b0\u09b9\u09ae\u09be\u09a8\u09bf\u09b0 \u09b0\u09b9\u09c0\u09ae<\/strong><\/p>\n<p>\u09a6\u09c1\u09a8\u09bf\u09df\u09be \u0993 \u0986\u0996\u09bf\u09b0\u09be\u09a4\u09c7\u09b0 \u0995\u09b2\u09cd\u09af\u09be\u09a3\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u0986\u09a8\u09cd\u09a4\u09b0\u09cd\u099c\u09be\u09a4\u09bf\u0995 \u09ae\u09be\u09a8\u09c7\u09b0 \u09b6\u09bf\u0995\u09cd\u09b7\u09be\u09b0 \u0985\u0999\u09cd\u0997\u09c0\u0995\u09be\u09b0 \u09a8\u09bf\u09df\u09c7 \u09b8\u09be\u09ad\u09be\u09b0\u09c7 \u09b6\u09c1\u09b0\u09c1 \u09b9\u09b2\u09cb<br \/><strong>\u0645\u062f\u0631\u0633\u0629 \u0627\u0644\u062d\u0633\u0646\u0629\u00a0\u09ae\u09be\u09a6\u09b0\u09be\u09b8\u09be\u09a4\u09c1\u09b2 \u09b9\u09be\u09b8\u09be\u09a8\u09be\u09b9<br \/><br \/><\/strong><\/p>\n<p><em>\u09b9\u09c7 \u0986\u09ae\u09be\u09a6\u09c7\u09b0 \u09aa\u09be\u09b2\u09a8\u0995\u09b0\u09cd\u09a4\u09be!\u0986\u09ae\u09be\u09a6\u09c7\u09b0\u0995\u09c7 \u09a6\u09c1\u09a8\u09bf\u09df\u09be\u09a4\u09c7\u0993 \u0995\u09b2\u09cd\u09af\u09be\u09a3 \u09a6\u09be\u09a8 \u0995\u09b0\u09cb; \u0986\u0996\u09bf\u09b0\u09be\u09a4\u09c7\u0993 \u0995\u09b2\u09cd\u09af\u09be\u09a3 \u09a6\u09be\u09a8 \u0995\u09b0\u09cb\u0964 \u0986\u09b0 \u099c\u09be\u09b9\u09be\u09a8\u09cd\u09a8\u09be\u09ae\u09c7\u09b0 \u0986\u099c\u09be\u09ac \u09b9\u09a4\u09c7\u0993 \u09b0\u0995\u09cd\u09b7\u09be \u0995\u09b0\u09cb \u0964<\/em> -\u09b8\u09c2\u09b0\u09be \u0986\u09b2 \u09ac\u09be\u0995\u09be\u09b0\u09be \u09e8\u09e6\u09e7<br \/><br \/><\/p>\n<p>\u09b8\u09ae\u09cd\u09ae\u09be\u09a8\u09bf\u09a4 \u09b8\u09c1\u09a7\u09c0,<\/p>\n<p>\u0986\u09b8\u09b8\u09be\u09b2\u09be\u09ae\u09c1 \u0986\u09b2\u09be\u0987\u0995\u09c1\u09ae\u0964 \u09a6\u09c1\u09a8\u09bf\u09df\u09be \u098f\u09ac\u0982 \u0986\u0996\u09bf\u09b0\u09be\u09a4\u09c7\u09b0 \u0995\u09b2\u09cd\u09af\u09be\u09a3 \u09b2\u09be\u09ad\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u09a6\u09c1\u09df\u09be \u0995\u09b0\u09be\u09b0 \u09aa\u09be\u09b6\u09be\u09aa\u09be\u09b6\u09bf &#8216;\u0987\u09b2\u09ae \u098f\u09ac\u0982 &#8216;\u0986\u09ae\u09b2\u09c7\u09b0 \u09ae\u09be\u09a7\u09cd\u09af\u09ae\u09c7 \u0986\u09ae\u09be\u09a6\u09c7\u09b0 \u09b8\u09b0\u09cd\u09ac\u09be\u09a4\u09cd\u09ae\u0995 \u09aa\u09cd\u09b0\u099a\u09c7\u09b7\u09cd\u099f\u09be \u0993 \u0985\u09ac\u09cd\u09af\u09be\u09b9\u09a4 \u09b0\u09be\u0996\u09a4\u09c7 \u09b9\u09ac\u09c7\u0964 \u0986\u09ae\u09be\u09a6\u09c7\u09b0 \u09aa\u09cd\u09b0\u09a4\u09bf\u09b7\u09cd\u09a0\u09be\u09a8 <strong>\u09ae\u09be\u09a6\u09b0\u09be\u09b8\u09be\u09a4\u09c1\u09b2 \u09b9\u09be\u09b8\u09be\u09a8\u09be\u09b9 <\/strong>\u09b8\u09c7 \u09b2\u0995\u09cd\u09b7\u09cd\u09af\u09c7\u0987 \u09aa\u09cd\u09b0\u09a4\u09bf\u09b7\u09cd\u09a0\u09bf\u09a4 \u09b9\u09df\u09c7\u099b\u09c7\u0964<\/p>\n<p>\u0986\u09aa\u09a8\u09be\u09b0\u09be \u099c\u09be\u09a8\u09c7\u09a8, \u0986\u09ae\u09be\u09a6\u09c7\u09b0 \u09a6\u09c7\u09b6\u09c7 \u09b0\u09df\u09c7\u099b\u09c7 \u09a8\u09be\u09a8\u09be \u09b0\u0995\u09ae \u09b6\u09bf\u0995\u09cd\u09b7\u09be\u09ac\u09cd\u09af\u09ac\u09b8\u09cd\u09a5\u09be-\u099c\u09c7\u09a8\u09be\u09b0\u09c7\u09b2 \u09b6\u09bf\u0995\u09cd\u09b7\u09be, \u0986\u09b2\u09c0\u09df\u09be, \u0995\u0989\u09ae\u09c0, \u09b9\u09bf\u09ab\u099c\u09c1\u09b2 \u0995\u09c1\u09b0\u0986\u09a8, \u0987\u0982\u09b2\u09bf\u09b6 \u09ae\u09bf\u09a1\u09bf\u09df\u09be\u09ae, \u0995\u09be\u09b0\u09bf\u0997\u09b0\u09c0 \u00a0\u0987\u09a4\u09cd\u09af\u09be\u09a6\u09bf\u0964 \u098f \u09b8\u09ac\u09c7\u09b0 \u09b8\u09ae\u09a8\u09cd\u09ac\u09df\u09c7 \u098f\u0995\u099f\u09bf \u0986\u09a8\u09cd\u09a4\u09b0\u09cd\u099c\u09be\u09a4\u09bf\u0995 \u09ae\u09be\u09a8\u09c7\u09b0\u00a0 \u09b6\u09bf\u0995\u09cd\u09b7\u09be\u09aa\u09cd\u09b0\u09a4\u09bf\u09b7\u09cd\u09a0\u09be\u09a8 \u0997\u09dc\u09a4\u09c7 \u0986\u09ae\u09b0\u09be \u0995\u09be\u099c \u0995\u09b0\u09c7 \u09af\u09be\u099a\u09cd\u099b\u09bf\u0964 \u098f\u0996\u09be\u09a8\u09c7 \u0995\u09c1\u09b0\u0986\u09a8-\u09b8\u09c1\u09a8\u09cd\u09a8\u09be\u09b9\u09ad\u09bf\u09a4\u09cd\u09a4\u09bf\u0995 \u09b6\u09c1\u09a6\u09cd\u09a7 \u0987\u09b8\u09b2\u09be\u09ae \u0985\u09a8\u09c1\u09a7\u09be\u09ac\u09a8 \u0993\u00a0 \u0985\u09a8\u09c1\u09b6\u09c0\u09b2\u09a8, \u098f\u09ac\u0982 \u0986\u09ae\u09be\u09a6\u09c7\u09b0 \u099c\u09be\u09a4\u09c0\u09df \u0989\u09a8\u09cd\u09a8\u09a4\u09bf\u09b0 \u09b2\u0995\u09cd\u09b7\u09cd\u09af\u09c7 \u0986\u099c\u0995\u09c7\u09b0 \u09b6\u09bf\u09b6\u09c1\u09a6\u09c7\u09b0\u0995\u09c7 \u0986\u0997\u09be\u09ae\u09c0 \u09a6\u09bf\u09a8\u09c7\u09b0 \u09b8\u09c1\u09a8\u09be\u0997\u09b0\u09bf\u0995 \u09b9\u09bf\u09b8\u09c7\u09ac\u09c7 \u0997\u09dc\u09c7 \u09a4\u09cb\u09b2\u09be\u09b0 \u09ac\u09bf\u09b7\u09df\u099f\u09bf \u09b8\u09b0\u09cd\u09ac\u09be\u09a7\u09bf\u0995 \u0997\u09c1\u09b0\u09c1\u09a4\u09cd\u09ac \u09a6\u09bf\u09df\u09c7 \u0986\u09a6\u09ac, \u0986\u0996\u09b2\u09be\u0995, \u0986\u09b0 \u09a4\u09be\u0995\u0993\u09df\u09be\u09b0 \u09b8\u09ac\u0995 \u098f\u09ac\u0982 \u09b8\u09ae\u0995\u09be\u09b2\u09c0\u09a8 \u099c\u09cd\u099e\u09be\u09a8-\u09ac\u09bf\u099c\u09cd\u099e\u09be\u09a8-\u09aa\u09cd\u09b0\u09af\u09c1\u0995\u09cd\u09a4\u09bf\u09b0 \u09aa\u09cd\u09b0\u09b6\u09bf\u0995\u09cd\u09b7\u09a3\u09c7\u09b0 \u09ae\u09be\u09be\u09a7\u09cd\u09af\u09ae\u09c7 \u0986\u09aa\u09a8\u09be\u09b0-\u0986\u09ae\u09be\u09b0 \u0995\u09b2\u09bf\u099c\u09be\u09b0 \u099f\u09c1\u0995\u09b0\u09cb\u0997\u09c1\u09b2\u09cb\u0995\u09c7 \u09a4\u09be\u0993\u09b9\u09c0\u09a6\u09c0 \u09b8\u09cb\u09a8\u09be\u09b0 \u09ae\u09be\u09a8\u09c1\u09b7 \u09ac\u09be\u09a8\u09be\u09a4\u09c7 \u099a\u09be\u0987\u0964<br \/><br \/><\/p>\n<p>\u0986\u09b2\u09cd\u09b2\u09be\u09b9 \u09b0\u09ac\u09cd\u09ac\u09c1\u09b2 \u0986\u09b2\u09be\u09ae\u09c0\u09a8 \u0986\u09aa\u09a8\u09be\u09a6\u09c7\u09b0 \u09b8\u09b9\u09be\u09df \u09b9\u09cb\u09a8\u0964<\/p>\n<p>\u099c\u09be\u09af\u09be\u0995\u09c1\u09ae\u09c1\u09b2\u09cd\u09b2\u09be\u09b9 \u0996\u09be\u0987\u09b0\u09be\u09a8\u0964<\/p>\n<p><!-- \/wp:paragraph --><\/p>\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t\t\t<\/div>\n\t\t<\/section>\n\t\t\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t","protected":false},"excerpt":{"rendered":"<p>\u0986\u09ae\u09be\u09a6\u09c7\u09b0 \u0995\u09a5\u09be \u09ac\u09bf\u09b8\u09ae\u09bf\u09b2\u09cd\u09b2\u09be\u09b9\u09bf\u09b0 \u09b0\u09b9\u09ae\u09be\u09a8\u09bf\u09b0 \u09b0\u09b9\u09c0\u09ae \u09a6\u09c1\u09a8\u09bf\u09df\u09be \u0993 \u0986\u0996\u09bf\u09b0\u09be\u09a4\u09c7\u09b0 \u0995\u09b2\u09cd\u09af\u09be\u09a3\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u0986\u09a8\u09cd\u09a4\u09b0\u09cd\u099c\u09be\u09a4\u09bf\u0995 \u09ae\u09be\u09a8\u09c7\u09b0 \u09b6\u09bf\u0995\u09cd\u09b7\u09be\u09b0 \u0985\u0999\u09cd\u0997\u09c0\u0995\u09be\u09b0 \u09a8\u09bf\u09df\u09c7 \u09b8\u09be\u09ad\u09be\u09b0\u09c7 \u09b6\u09c1\u09b0\u09c1 \u09b9\u09b2\u09cb\u0645\u062f\u0631\u0633\u0629 \u0627\u0644\u062d\u0633\u0646\u0629\u00a0\u09ae\u09be\u09a6\u09b0\u09be\u09b8\u09be\u09a4\u09c1\u09b2 \u09b9\u09be\u09b8\u09be\u09a8\u09be\u09b9 \u09b9\u09c7 \u0986\u09ae\u09be\u09a6\u09c7\u09b0 \u09aa\u09be\u09b2\u09a8\u0995\u09b0\u09cd\u09a4\u09be!\u0986\u09ae\u09be\u09a6\u09c7\u09b0\u0995\u09c7 \u09a6\u09c1\u09a8\u09bf\u09df\u09be\u09a4\u09c7\u0993 \u0995\u09b2\u09cd\u09af\u09be\u09a3 \u09a6\u09be\u09a8 \u0995\u09b0\u09cb; \u0986\u0996\u09bf\u09b0\u09be\u09a4\u09c7\u0993 \u0995\u09b2\u09cd\u09af\u09be\u09a3 \u09a6\u09be\u09a8&hellip; <a class=\"more-link\" href=\"https:\/\/www.madrasatulhasanah.com\/%e0%a6%86%e0%a6%ae%e0%a6%be%e0%a6%a6%e0%a7%87%e0%a6%b0-%e0%a6%95%e0%a6%a5%e0%a6%be\/\">Continue reading <span class=\"screen-reader-text\">\u0986\u09ae\u09be\u09a6\u09c7\u09b0 \u0995\u09a5\u09be<\/span><\/a><\/p>\n","protected":false},"author":1,"featured_media":0,"parent":0,"menu_order":0,"comment_status":"closed","ping_status":"closed","template":"","meta":{"footnotes":""},"class_list":["post-81","page","type-page","status-publish","hentry","entry"],"_links":{"self":[{"href":"https:\/\/www.madrasatulhasanah.com\/wp-json\/wp\/v2\/pages\/81","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.madrasatulhasanah.com\/wp-json\/wp\/v2\/pages"}],"about":[{"href":"https:\/\/www.madrasatulhasanah.com\/wp-json\/wp\/v2\/types\/page"}],"author":[{"embeddable":true,"href":"https:\/\/www.madrasatulhasanah.com\/wp-json\/wp\/v2\/users\/1"}],"replies":[{"embeddable":true,"href":"https:\/\/www.madrasatulhasanah.com\/wp-json\/wp\/v2\/comments?post=81"}],"version-history":[{"count":89,"href":"https:\/\/www.madrasatulhasanah.com\/wp-json\/wp\/v2\/pages\/81\/revisions"}],"predecessor-version":[{"id":2309,"href":"https:\/\/www.madrasatulhasanah.com\/wp-json\/wp\/v2\/pages\/81\/revisions\/2309"}],"wp:attachment":[{"href":"https:\/\/www.madrasatulhasanah.com\/wp-json\/wp\/v2\/media?parent=81"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}}